# Anthropic API key (from console.anthropic.com) - required
ANTHROPIC_API_KEY=sk-ant-your-key

# Model for the agent's reasoning. claude-sonnet-5 is the recommended
# default. Use claude-haiku-4-5-20251001 for lower cost.
AGENT_MODEL=claude-sonnet-5

# Where the SQLite database file lives. On a host with a persistent
# volume, point this inside that volume (see README).
DATABASE_PATH=./data/setter.db

# Port the server listens on. Most hosts set this automatically.
PORT=3000

# Optional: a shared password to gate access to your app. If set, the
# web page will ask for it before letting anyone in. Leave blank for
# no password (fine if the URL is private / only you know it).
APP_PASSWORD=
